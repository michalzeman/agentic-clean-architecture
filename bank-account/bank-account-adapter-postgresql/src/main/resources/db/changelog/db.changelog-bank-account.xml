<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ChangeSet 1: Create the bank_account schema -->
    <changeSet id="1" author="migration-team">
        <sql>
            CREATE SCHEMA IF NOT EXISTS bank_account;
        </sql>
        <comment>Create bank_account schema</comment>
    </changeSet>

    <!-- ChangeSet 2: Create Spring Integration tables in bank-account schema -->
    <changeSet id="2" author="migration-team">
        <sqlFile path="classpath:db/changelog/V1__spring_integration_schema.sql"
                 relativeToChangelogFile="false"
                 splitStatements="true"
                 stripComments="true"/>
        <comment>Spring Integration JDBC Message Store schema in bank_account schema</comment>
    </changeSet>

    <!-- ChangeSet 3: Create bank_account aggregate table for PostgreSQL persistence adapter -->
    <changeSet id="3" author="migration-team">
        <sqlFile path="V2__bank_account_table.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"/>
        <comment>bank_account aggregate table for postgres-persistence profile</comment>
    </changeSet>

    <!-- ChangeSet 4: Add aggregate_version for domain event-count separate from optimistic-lock version -->
    <changeSet id="4" author="migration-team">
        <sqlFile path="V3__bank_account_aggregate_version.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"/>
        <comment>aggregate_version column for domain event-count; existing version column becomes @Version token</comment>
    </changeSet>

</databaseChangeLog>
